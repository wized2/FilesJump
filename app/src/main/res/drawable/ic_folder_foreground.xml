<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon foreground: 108x108dp canvas.
  Artwork is scaled to ~50dp wide and centered, so it sits fully inside
  the 66dp circular safe zone (no clipping under any launcher mask).
  Pair with a white background layer.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Original artwork coordinates (175..640 x 208..560) scaled and centered on 54,54 -->
    <group
        android:pivotX="0"
        android:pivotY="0"
        android:scaleX="0.10753"
        android:scaleY="0.10753"
        android:translateX="10.18"
        android:translateY="12.71">

        <!-- Back of folder -->
        <path android:pathData="M175,560 V258 Q175,208 225,208 H318 Q334,208 346,218 L372,242 Q382,248 396,248 H518 Q565,248 565,295 V560 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="175"
                    android:startY="0"
                    android:endX="565"
                    android:endY="0">
                    <item android:offset="0" android:color="#FF3A7DF8" />
                    <item android:offset="1" android:color="#FF5DA9FF" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Front flap -->
        <path android:pathData="M175,560 L238,335 Q248,312 272,312 L600,312 Q640,312 636,350 L590,538 Q583,560 560,560 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="175"
                    android:startY="0"
                    android:endX="640"
                    android:endY="0">
                    <item android:offset="0" android:color="#FF78B6FF" />
                    <item android:offset="0.7" android:color="#FF76BBFF" />
                    <item android:offset="1" android:color="#FF9ACEFE" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Soft purple tint along the top of the flap, clipped to the flap shape -->
        <group>
            <clip-path android:pathData="M175,560 L238,335 Q248,312 272,312 L600,312 Q640,312 636,350 L590,538 Q583,560 560,560 Z" />
            <path android:pathData="M175,312 H645 V422 H175 Z">
                <aapt:attr name="android:fillColor">
                    <gradient
                        android:type="linear"
                        android:startX="0"
                        android:startY="312"
                        android:endX="0"
                        android:endY="420">
                        <item android:offset="0" android:color="#8CB09CFB" />
                        <item android:offset="1" android:color="#00B09CFB" />
                    </gradient>
                </aapt:attr>
            </path>
        </group>
    </group>
</vector>